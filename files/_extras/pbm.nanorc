# Source: https://github.com/pazmivaniye/nanorc/blob/ff8e37d2e833e1adce0edd690f57783dca97f8b0/pbm.nanorc
# License: MIT

syntax "pbm" "\.pbm$"
comment "#"

# Values.
color black,white "0\s*"
color italic,lightblack,black "1\s*"

color black,white "[^ -~]"

# Comments.
color italic,lightblack "^\s*#.*"

color ,white "\s+$"
