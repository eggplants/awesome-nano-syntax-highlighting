# Source: https://github.com/pazmivaniye/nanorc/blob/ff8e37d2e833e1adce0edd690f57783dca97f8b0/paz.nanorc
# License: MIT

syntax "paz" "\.paz$"
header "^#!.*paz\b"
comment "#"

# Reserved words.
color bold,lightwhite "\b(import|extern|namespace|return|class|with|and|or)\b"
color bold,lightwhite "\b(for|if|while|try|catch|throw|else|true|false|in)\b"
color bold,lightwhite "\b(local|static|const|auto|self|cast|from)\b"

color black,white "[^ -~]"

# Comments.
color italic,lightblack "(^|\s)#.*"

# Shebangs.
color bold,lightwhite "^#!.*paz\b.*"

color ,white "\s+$"
