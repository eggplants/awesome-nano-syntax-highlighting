syntax "Keymap" "\.(k|key)?map$|Xmodmap$"

color cyan  "\<(add|clear|compose|keycode|keymaps|keysym|remove|string)\>"
color cyan  "\<(control|alt|shift)\>"
color blue   "\<[0-9]+\>"
color red "="
color yellow ""(\\.|[^"])*"|'(\\.|[^'])*'"
color brightblack  "^!.*$"
color ,green "[[:space:]]+$"
color ,red "	+ +| +	+"
