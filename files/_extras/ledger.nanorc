# Source: https://github.com/galenguyer/nano-syntax-highlighting/blob/6f7cb16bf238fa5c55995377ec9d1d3fa9b9515f/ledger.nanorc
# License: GPL-3.0-or-later

syntax "Ledger" "(^|\.|/)(ledger|ldgr|lg)$"

# descriptions
color brightmagenta "^(([0-9]{4}(/|-|.))?[0-9]{2}(/|-|.)[0-9]{2}|[=~]) .*"
# dates
color blue "^([0-9]{4}(\/|-|.))?[0-9]{2}(\/|-|.)[0-9]{2}"
# balance
color brightyellow "^~ .*"
color brightblue "^= .*"
# accounts
color cyan "(\t| )\b\w*\ ?\w*(:\w*\ ?\w*\w*){1,}\b"
# double quotes and transaction flags
color red "[*!@\"]"
# text within double quotes
color pink "\"(.*?)\""
# comments
color brightblack "(^|\s)(;|#|%|\|).*"
color brightwhite,yellow "\<(FIXME|TODO|XXX)\>"
