# Source: https://github.com/sami2020pro/vile-nanorc/blob/b1972821d5ff7ccc169e42255a1ce74395fe09fe/vile.nanorc
# License: MIT

syntax "vile" "\.vl$"

## keywords
color brightwhite "\<(fn|if|do|var|func|macro|code|import|false|true)\>"

## primitives
color brightblue "\<(eval|exit|len|cons|car|cdr|type)\>"
color brightblue "\<(round|ceil|floor|log|sin|cos|inc|dec|compile|puts|put|list|concat)\>"
color brightblue "(\+|-|\*|/|=|<=|>=|>|<|&|\||^|<<|>>|')"

## paranthese
color brightyellow "(\(|\))"

## strings
color green "\"([^"\]|\\.)+""
color green start="\"\"\"([^"),]|$)" end="(^|[^(\])\"\"\""
