# Source: https://github.com/pazmivaniye/nanorc/blob/ff8e37d2e833e1adce0edd690f57783dca97f8b0/nasm.nanorc
# License: MIT

syntax "nasm" "\.s$"
comment ";"

# Reserved words.
icolor bold,lightwhite "\b(section|global|incbin)\b"
icolor normal,normal "\$[a-z_.?][a-z0-9_$#@~.?]*\b"

color black,white "[^ -~]"

# Comments.
color italic,lightblack ";.*"

color ,white "\s+$"
