# Source: https://github.com/galenguyer/nano-syntax-highlighting/blob/6f7cb16bf238fa5c55995377ec9d1d3fa9b9515f/creole.nanorc
# License: GPL-3.0-or-later

syntax "Creole" "\.creole$"

# Headers
color magenta "^=.*=$"

# Lists
color green "^[#*]+\s.*"

# Links and images
color cyan start="\[\[" end="\]\]"
color cyan start="\{\{" end="\}\}"

# Emphasis
color yellow "//.*//"
color brightyellow "\*\*.*\*\*"

# Pre and tables
color red start="\{\{\{" end="\}\}\}"
color red "\|"
color brightred "\|="

color ,red "\s+$"
