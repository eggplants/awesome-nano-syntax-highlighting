# Source: https://github.com/galenguyer/nano-syntax-highlighting/blob/6f7cb16bf238fa5c55995377ec9d1d3fa9b9515f/inputrc.nanorc
# License: GPL-3.0-or-later

syntax "Inputrc" "inputrc$"

color red   "\<(off|none)\>"
color green "\<on\>"
color brightblue   "\<set|\$include\>"
color yellow ""(\\.|[^"])*"|'(\\.|[^'])*'"
color magenta     "\\.?"
color brightblack "(^|[[:space:]])#([^{].*)?$"
color brightwhite,yellow "\<(FIXME|TODO|XXX)\>"
color ,green "[[:space:]]+$"
color ,red "	+ +| +	+"
