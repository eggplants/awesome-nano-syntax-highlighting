## Syntax highlighting for emails.

syntax email "\.eml$"

# Quoted lines.
color green "^>.*"
color cyan "^> ?>.*"
color yellow "^> ?> ?>.*"

# Email addresses.
color brightmagenta "<[^@]+@[^@]+>"

# URLs.
color brightblue "(https?|ftp)://\S+\.\S+[^[:space:].)]"

# Signatures, even quoted ones.
color yellow start="^>* ?-- $" end="^>* ?$"
