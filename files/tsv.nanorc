# Syntax highlighting for TSV files.

syntax tsv "\.tsv$"

tabgives "	"

# Tabs.
# https://www.iana.org/assignments/media-types/text/tab-separated-values
color ,magenta "	"

# Strings.
color green ""([^"\]|\\.)*""

# Trailing whitespaces.
color ,green " +$"
