# Syntax highlighting for log files.

syntax log "\.log$"

tabgives "	"

# Dates.
color blue "(^| )\[[^]]+\] "

# Strings.
color green ""([^"\]|\\.)*""
color green "'([^'\]|\\.)*'"

# Trailing whitespaces.
color ,green " +$"
