# Source: https://github.com/pazmivaniye/nanorc/blob/ff8e37d2e833e1adce0edd690f57783dca97f8b0/matlab.nanorc
# License: MIT

syntax "matlab" "\.m$"
comment "%"
color black,white "[^ -~]"

# Comments.
color italic,lightblack "(%|\.\.\.).*"
color italic,lightblack start="%\{" end="%\}"

# Section headings.
color bold,lightwhite "^\s*%%.*"

color ,white "\s+$"
