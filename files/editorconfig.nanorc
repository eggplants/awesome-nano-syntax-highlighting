# Source: https://github.com/serialhex/nano-highlight/blob/d3fdc6a29658503f8b19bff1a0809406859f7f06/editorconfig.nanorc
# License: Unlicense

syntax "editorconfig" "\.editorconfig(\.old|\.bak|~)?$"

## Values
color brightred "=.*$"

## Equal sign
color yellow "="

## Sections
color brightgreen "^\s*\[.*\]"

## Keys
color cyan "^\s*[a-zA-Z0-9_\.]+"

## Comments
color brightblack ";.*$"
