# Source: https://github.com/galenguyer/nano-syntax-highlighting/blob/6f7cb16bf238fa5c55995377ec9d1d3fa9b9515f/subrip.nanorc
# License: GPL-3.0-or-later

syntax "subrip" "\.srt$"

# Subtitle number
color yellow "^[0-9]+$"

# Timecode
color green "^[0-9]{2}:[0-9]{2}:[0-9]{2},[0-9]{3} --> [0-9]{2}:[0-9]{2}:[0-9]{2},[0-9]{3}"

# Tags
color cyan "<[[:alpha:]/!?][^>]*>"
