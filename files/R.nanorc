## Syntax highlighting for R files
## Drop in ~/.nano/ and add `include "~/.nano/R.nanorc"` to ~/.nanorc

syntax "R" "\.R$"
header "^#!.*/Rscript"

## Reserved words (including '...', '..1', etc.)
color brightgreen "(\<(break|else|for|function|if|in|next|repeat|return|while)\>|[.]{3,3}|[.]{2,2}[0-9]+)"

## Assignment operators (<-, <<-, ->, ->>)
color green "(->>?|<{1,2}-)"

## Formula tilde
color green "~"

## Namespace operators (:::  before :: so the longer match wins)
color green ":::"
color green "::"

## Native pipe (R 4.1+) and data.table walrus operator
color green "\|>|:="

## Delimiters
color green "[\)\(,;]+|[\{\}]+|[][]+"

## Boolean constants
color brightblue "\<(TRUE|FALSE|NA)\>"

## Other special constants
color brightblue "\<(Inf|NA_character_|NA_complex_|NA_integer_|NA_real_|NaN|NULL|LETTERS|letters|pi)\>"

## Special operators (%>%, %in%, %*%, %o%, %chin%, etc.)
color brightcyan "%[^%]*%"

## Integers
color brightred "\<[0-9]+[iL]?\>"

## Floating-point numbers
color brightred "\<([0-9]+[Ee][-+]?[0-9]+|([0-9]*\.[0-9]+|[0-9]+\.)([Ee][-+]?[0-9]+)?)[i]?\>"

## Backtick-quoted names
color brightmagenta "`[^`]*`"

## $ and @ slot/field accessors
color brightwhite "[@$][a-zA-Z.][a-zA-Z0-9._]*"

################################################################################
## Package-specific function highlighting (alphabetical by package)
## To add a package: copy any section below and replace function names.
################################################################################

## arrow — parquet / Arrow dataset I/O
color brightcyan "\<(read_parquet|write_parquet|open_dataset|write_dataset|collect|as_arrow_table|arrow_table|read_csv_arrow|read_feather|write_feather|read_ipc_file|write_ipc_file|schema|field)\>"

## assertthat — readable assertions
color brightcyan "\<(assert_that|see_if|validate_that|is\.flag|is\.string|is\.count|is\.number|not_empty|noNA|are_equal)\>"

## broom — tidy model output
color brightcyan "\<(tidy|glance|augment)\>"

## data.table — fast in-memory data manipulation
color brightcyan "\<(data\.table|as\.data\.table|is\.data\.table|fread|fwrite|setDT|setDF|setkey|setkeyv|setorder|setorderv|setnames|setcolorder|rbindlist|dcast|melt|merge|tstrsplit|uniqueN|nafill|shift|frollmean|frollsum|frollapply|CJ|SJ|fifelse|fcase|fcoalesce|fintersect|fsetdiff|funion|frank|frankv|rowidv|rowid|copy|setDTthreads|getDTthreads|tables|key|haskey|indices)\>"
## data.table special variables: \< word boundary cannot precede a dot (dot is non-word), so matched separately
color brightcyan "\.SDcols\>|\.SD\>|\.N\>|\.GRP\>|\.NGRP\>|\.BY\>|\.I\>"

## DBI / duckdb — database connectivity
color brightcyan "\<(dbConnect|dbDisconnect|dbGetQuery|dbSendQuery|dbFetch|dbClearResult|dbExecute|dbWriteTable|dbReadTable|dbListTables|dbExistsTable|dbRemoveTable|duckdb|duckdb_register|duckdb_unregister)\>"

## dplyr / tidyr / purrr — tidyverse data manipulation
color brightcyan "\<(mutate|transmute|filter|select|arrange|summarize|summarise|group_by|ungroup|rename|rename_with|distinct|slice|slice_head|slice_tail|slice_min|slice_max|slice_sample|pull|count|tally|add_count|add_tally|across|if_any|if_all|if_else|case_when|case_match|coalesce|n|n_distinct|row_number|cur_group_id|cur_group|lead|lag|left_join|right_join|inner_join|full_join|anti_join|semi_join|cross_join|bind_rows|bind_cols|rowwise|nest|unnest|unnest_wider|unnest_longer|hoist|pivot_longer|pivot_wider|separate|separate_wider_delim|separate_wider_regex|separate_wider_position|unite|drop_na|replace_na|fill|complete|expand|expand_grid|starts_with|ends_with|contains|matches|everything|all_of|any_of|last_col|rownames_to_column|column_to_rownames|map|map2|pmap|imap|map_dbl|map_chr|map_int|map_lgl|map_df|map_vec|walk|walk2|pwalk|reduce|accumulate|keep|discard|compact|pluck|chuck|every|some|none|tibble|as_tibble|tribble|enframe|deframe|glimpse)\>"

## estimatr — regression with robust standard errors
color brightcyan "\<(lm_robust|iv_robust|difference_in_means|horvitz_thompson|commarobust)\>"

