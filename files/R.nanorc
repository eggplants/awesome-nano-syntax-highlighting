color brightcyan "\<(feols|feglm|fepois|fenegbin|femlm|feNmlm|etable|esttex|esttable|coefplot|iplot|fixef|did_means|did_estimate_yearly_effects|sunab|i|hat_values_fixest|setFixest_fml|setFixest_dict|fitstat|wald|ref|poly|l|f|d|bin|csteps|smpl|fitstat_register)\>"

