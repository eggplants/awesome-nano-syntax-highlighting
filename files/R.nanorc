## library() / require() — entire call highlighted so any package name is visible
color yellow "\<(library|require)[ \t]*\([^)]*\)"

## base R — dotted builtins (placed after package rules to override partial matches, e.g. 'path' inside file.path)
color brightcyan "\<(data\.frame|as\.data\.frame|as\.numeric|as\.character|as\.logical|as\.integer|as\.double|as\.complex|as\.raw|as\.factor|as\.ordered|as\.Date|as\.POSIXct|as\.POSIXlt|as\.difftime|as\.list|as\.vector|as\.matrix|as\.array|as\.table|as\.function|as\.environment|as\.call|as\.name|as\.symbol|as\.expression|is\.numeric|is\.character|is\.logical|is\.integer|is\.double|is\.complex|is\.raw|is\.factor|is\.ordered|is\.Date|is\.list|is\.vector|is\.matrix|is\.array|is\.table|is\.function|is\.environment|is\.null|is\.na|is\.nan|is\.finite|is\.infinite|is\.recursive|is\.atomic|is\.primitive|is\.language|is\.call|is\.name|is\.symbol|is\.element|is\.data\.frame|do\.call|match\.arg|match\.call|match\.fun|on\.exit|sys\.call|sys\.function|sys\.frame|sys\.nframe|sys\.source|parent\.frame|file\.path|file\.exists|file\.copy|file\.rename|file\.remove|file\.create|file\.info|file\.access|file\.show|file\.append|list\.files|list\.dirs|Sys\.time|Sys\.Date|Sys\.sleep|Sys\.getenv|Sys\.setenv|Sys\.getwd|Sys\.setwd|Sys\.info|Sys\.glob|proc\.time|system\.time|read\.csv|read\.csv2|read\.table|read\.delim|read\.fwf|write\.csv|write\.csv2|write\.table|installed\.packages|available\.packages|install\.packages|update\.packages|remove\.packages|system\.file|path\.expand|packageVersion)\>"

## Strings, double-quoted
color brightyellow ""([^"]|(\\"))*""

## Strings, single-quoted
color brightyellow "'([^']|(\\'))*'"

## Comments
color magenta "#[^'].*$" "#$"

## Roxygen-style comments (must follow the comments rule to override it)
color cyan "#'.*$"
