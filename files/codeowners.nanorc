# Source: https://github.com/gerph/nano-colour/blob/5439fcc133f9b34ca3ad785717ab6aefcf216ca1/examples/codeowners.nanorc
# License: MIT

syntax "codeowners" "CODEOWNERS$"
comment "#"

# Comments.
color green "^#.*| #.*"

# Spaces in front of tabs.
color ,red " +	+"

# Paths at the front
color brightblue "^([^# /]*/)*[^#/ ]+"
color blue "^([^# /]*/)*"

# Invalid lines
color red "^[^# ]+ +[^#@]*$"
color red "^[^# ]+$"

# Email addresses.
color magenta " [[:alnum:].%_+-]+@[[:alnum:].-]+\.[[:alpha:]]{2,}\b"

# Groups
color cyan " @[[:alnum:]/.:-]+\b"
